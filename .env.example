# PBXPuls runtime configuration.
# For a clean FreePBX 16/17 installation use install.sh. It creates random
# passwords, writes this file as .env and stores a root-only credentials report.

NODE_ENV="production"
PORT="3000"
JWT_SECRET=""

# FreePBX / Asterisk MariaDB (read-only).
# The clean installer creates pbxpuls@localhost and pbxpuls@127.0.0.1.
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="asteriskcdrdb"
DB_USER="pbxpuls"
DB_PASS=""

# Compatibility aliases used by older PBXPuls integrations.
FREEPBX_DB_HOST="localhost"
FREEPBX_DB_PORT="3306"
FREEPBX_DB_NAME="asteriskcdrdb"
FREEPBX_DB_USER="pbxpuls"
FREEPBX_DB_PASSWORD=""

# PBXPuls internal database (read/write).
PBXPULS_DB_HOST="127.0.0.1"
PBXPULS_DB_PORT="3306"
PBXPULS_DB_NAME="pbxpuls"
PBXPULS_DB_USER="pbxpuls"
PBXPULS_DB_PASSWORD=""

# Asterisk recordings.
RECORDINGS_PATH="/var/spool/asterisk/monitor"
RECORDINGS_URL_PREFIX=""
DEMO_MODE="false"

# Initial PBXPuls web users. The clean installer generates random passwords.
SU_USERNAME="su"
SU_PASSWORD=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
OPERATOR_USERNAME="operator"
OPERATOR_PASSWORD=""
OPERATOR_EXTENSION="101"

# Asterisk AMI. The clean installer creates a local-only AMI account named pbxpuls.
AMI_HOST="127.0.0.1"
AMI_PORT="5038"
AMI_USER="pbxpuls"
AMI_PASS=""
AMI_CONTEXT="from-internal"

# Compatibility aliases.
ASTERISK_AMI_HOST="127.0.0.1"
ASTERISK_AMI_PORT="5038"
ASTERISK_AMI_USER="pbxpuls"
ASTERISK_AMI_PASSWORD=""
ASTERISK_AMI_CONTEXT="from-internal"

# Server-side AI providers.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""

# 32-byte key as 64 hex characters or Base64. Required only for encrypted AI callback requests.
PBXPULS_AI_ACTION_ENCRYPTION_KEY=""
# Optional separate HMAC key for tenant-scoped phone hashes.
PBXPULS_AI_ACTION_HASH_KEY=""

# Passive ARI observer. Leave empty until Stage 7A is explicitly enabled and reviewed.
PBXPULS_ARI_BASE_URL=""
PBXPULS_ARI_WEBSOCKET_URL=""
PBXPULS_ARI_USERNAME=""
PBXPULS_ARI_PASSWORD=""
PBXPULS_ARI_STASIS_APP="pbxpuls-ai-control"
PBXPULS_AI_VOICE_ENCRYPTION_KEY=""
PBXPULS_AI_VOICE_HASH_KEY=""

# MTS Business balance API. Credentials remain backend-only and are never stored in PBXPuls SQL.
BALANCE_MTS_BUSINESS_ENABLED="false"
BALANCE_MTS_BUSINESS_API_BASE="https://api.mts.ru"
BALANCE_MTS_BUSINESS_CONSUMER_KEY=""
BALANCE_MTS_BUSINESS_CONSUMER_SECRET=""
BALANCE_MTS_BUSINESS_LOOKUP_TYPE="msisdn"
BALANCE_MTS_BUSINESS_MSISDN=""
BALANCE_MTS_BUSINESS_ACCOUNT_NO=""
BALANCE_MTS_BUSINESS_TIMEOUT_MS="15000"
BALANCE_MTS_BUSINESS_SYNC_INTERVAL_MINUTES="30"
BALANCE_MTS_BUSINESS_USAGE_OVERLAP_HOURS="24"
